function letterCombinations(digits: string): string[] {
  const telephoneButtons: { [id: string]: string[] } = {
    "2": ["a", "b", "c"],
    "3": ["d", "e", "f"],
    "4": ["g", "h", "i"],
    "5": ["j", "k", "l"],
    "6": ["m", "n", "o"],
    "7": ["p", "q", "r", "s"],
    "8": ["t", "u", "v"],
    "9": ["w", "x", "y", "z"],
  };

  const depth = digits.length;

  if (depth === 1) {
    return telephoneButtons[digits];
  }

  let result: string[] = [];

  function mix(first: string[], second: string[]): string[] {
    const arr = [];

    for (let i = 0; i < first.length; i++) {
      for (let j = 0; j < second.length; j++) {
        arr.push(first[i] + second[j]);
      }
    }

    return arr;
  }

  for (let i = 1; i < depth; i++) {
    let first = result.length === 0 ? telephoneButtons[digits[0]] : result;
    let second = telephoneButtons[digits[i]];

    result = mix(first, second);
  }

  return result;
}

function letterCombinations(digits: string): string[] {
  if (!digits.length) {
    return [];
  }

  const map: Record<string, string[]> = {
    "2": ["a", "b", "c"],
    "3": ["d", "e", "f"],
    "4": ["g", "h", "i"],
    "5": ["j", "k", "l"],
    "6": ["m", "n", "o"],
    "7": ["p", "q", "r", "s"],
    "8": ["t", "u", "v"],
    "9": ["w", "x", "y", "z"],
  };

  const result: string[] = [];

  function backtrack(index: number, path: string) {
    if (index === digits.length) {
      result.push(path);
      return;
    }

    for (const char of map[digits[index]]) {
      backtrack(index + 1, path + char);
    }
  }

  backtrack(0, "");
  return result;
}

console.log("result: ", letterCombinations("2"));
console.log("result: ", letterCombinations("23"));
console.log("result: ", letterCombinations("234"));
